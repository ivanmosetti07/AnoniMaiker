{
  "name": "anonimaiker",
  "productName": "AnoniMaiker",
  "version": "0.15.0",
  "description": "Usa l'intelligenza artificiale sui documenti dei tuoi clienti senza darle i dati veri.",
  "author": "Ivan Mosetti",
  "license": "SEE LICENSE IN ../LICENSE",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "motore": "node scripts/prepara-motore.mjs",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "onnxruntime-node": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.ivanmosetti.anonimaiker",
    "productName": "AnoniMaiker",
    "copyright": "© 2026 Ivan Mosetti · un prodotto MaikerHub",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "model.onnx",
          "tokenizer.json",
          "config.json"
        ]
      },
      {
        "from": "../App/Risorse/Licenze.md",
        "to": "Licenze.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "AnoniMaiker-Setup-${version}.${ext}",
      "shortcutName": "AnoniMaiker",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
